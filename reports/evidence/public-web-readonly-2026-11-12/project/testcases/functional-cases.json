[
  {
    "schema_version": "1.1.0",
    "id": "TC-UI-001",
    "kind": "ui",
    "revision": 1,
    "lifecycle": "active",
    "requirement_ids": [
      "REQ-RECORDED"
    ],
    "module": "未分组",
    "title": "公网只读：GitHub 搜索刷新与跨站 npm 查询",
    "priority": "P1",
    "preconditions": "无",
    "steps": [
      "打开 /deepseek-ai/deepseek-harness",
      "选择器 article 文本包含「DeepSeek Harness」",
      "打开 /search?q=deepseek-harness&type=repositories",
      "地址包含「q=deepseek-harness」",
      "选择器 main 文本包含「deepseek-ai/deepseek-harness」",
      "刷新页面",
      "选择器 main 文本包含「deepseek-ai/deepseek-harness」",
      "打开 https://registry.npmjs.org/-/v1/search?text=%40deepseek-ai%2Fdsh&size=3"
    ],
    "test_data": "仅合成数据；凭据以 ${ENV:名称} 引用",
    "expected": "选择器 pre 文本包含「@deepseek-ai/dsh」",
    "source": "autoskill record",
    "risk": "read",
    "tags": [],
    "extensions": {
      "automation": {
        "start_url": "/deepseek-ai/deepseek-harness",
        "actions": [
          {
            "assertion": "contains",
            "locators": [
              {
                "by": "css",
                "value": "article"
              },
              {
                "by": "css",
                "value": "div.Box_11__e1F7PX:nth-of-type(3) > div.Box_1__CzsAnb:nth-of-type(2) > div.Box_2__zaRucd > div.js-snippet-clipboard-copy-unpositioned.SharedMarkdownContent__JRRdYK:nth-of-type(2) > article.markdown-body.entry-content"
              }
            ],
            "expected": "DeepSeek Harness"
          },
          {
            "action": "goto",
            "url": "/search?q=deepseek-harness&type=repositories"
          },
          {
            "assertion": "url_contains",
            "expected": "q=deepseek-harness"
          },
          {
            "assertion": "contains",
            "locators": [
              {
                "by": "css",
                "value": "main"
              },
              {
                "by": "css",
                "value": "div.logged-out.env-production:nth-of-type(1) > div.application-main:nth-of-type(5) > main"
              }
            ],
            "expected": "deepseek-ai/deepseek-harness"
          },
          {
            "action": "reload"
          },
          {
            "assertion": "contains",
            "locators": [
              {
                "by": "css",
                "value": "main"
              },
              {
                "by": "css",
                "value": "div.logged-out.env-production:nth-of-type(1) > div.application-main:nth-of-type(5) > main"
              }
            ],
            "expected": "deepseek-ai/deepseek-harness"
          },
          {
            "action": "goto",
            "url": "https://registry.npmjs.org/-/v1/search?text=%40deepseek-ai%2Fdsh&size=3"
          }
        ],
        "assertions": [
          {
            "assertion": "contains",
            "locators": [
              {
                "by": "css",
                "value": "pre"
              }
            ],
            "expected": "@deepseek-ai/dsh"
          }
        ]
      }
    }
  }
]
