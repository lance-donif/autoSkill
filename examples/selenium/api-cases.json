[
  {
    "schema_version": "1.1.0",
    "id": "TC-API-001",
    "kind": "api",
    "revision": 1,
    "lifecycle": "active",
    "requirement_ids": [
      "REQ-API-001"
    ],
    "module": "目录依赖API",
    "title": "递归获取页面目录",
    "priority": "P1",
    "preconditions": "公共 GitHub API 可达且未限流；无认证，无写操作",
    "steps": [
      "向已确认的 Git Tree GET 路由发送请求",
      "校验状态码、JSON结构及本用例附加断言"
    ],
    "test_data": {
      "ref": "gh-pages",
      "query": {
        "recursive": "true"
      }
    },
    "expected": "HTTP 200；结构与附加断言满足官方 Get a tree 契约",
    "source": "https://github.com/SeleniumHQ/selenium/blob/trunk/common/src/web/index.html；https://docs.github.com/en/rest/git/trees?apiVersion=2022-11-28",
    "risk": "read",
    "tags": [
      "dependency-api",
      "public-get"
    ],
    "extensions": {
      "origin": "https://api.github.com",
      "extra_assertions": {
        "required_paths": [
          "web/index.html",
          "web/web-form.html",
          "web/submitted-form.html"
        ]
      },
      "scope": "Selenium 索引页的第三方依赖；不是 Selenium 业务 API",
      "expected_basis": "official-source-and-api-docs"
    },
    "api_source": "source-and-official-docs",
    "source_ref": "https://docs.github.com/en/rest/git/trees?apiVersion=2022-11-28（官方 API 文档确认，非本地 OpenAPI 文件）",
    "method": "GET",
    "path": "/repos/SeleniumHQ/selenium/git/trees/gh-pages",
    "headers": {
      "Accept": "application/vnd.github+json"
    },
    "params": {
      "recursive": "true"
    },
    "assertions": {
      "status": 200,
      "schema": {
        "type": "object",
        "required": [
          "sha",
          "url",
          "tree",
          "truncated"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "tree": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "mode",
                "type",
                "sha"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "blob",
                    "tree",
                    "commit"
                  ]
                },
                "sha": {
                  "type": "string"
                }
              }
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    }
  },
