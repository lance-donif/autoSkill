#!/bin/sh
# autoSkill entry point for Linux and Git Bash.
# Calls the bundled interpreter directly, so text with & < > | % passes through unchanged.
here=$(cd "$(dirname "$0")" && pwd)
py="$here/vendor/windows-x64/python/python.exe"
if [ "$(uname -s)" = Linux ] && [ -x "$here/../../.venv/bin/python" ]; then
  py="$here/../../.venv/bin/python"
elif [ -x "$py" ]; then
  export PYTHONNOUSERSITE=1
elif [ -n "$AUTOSKILL_DEV_PYTHON" ]; then
  py="$AUTOSKILL_DEV_PYTHON"
else
  echo '{"error": "runtime not found. Linux: follow docs/Linux-DSH.md; Windows: use the complete offline package. Nothing is downloaded."}'
  exit 3
fi
if command -v cygpath >/dev/null 2>&1; then
  PYTHONPATH=$(cygpath -w "$here/app")
else
  PYTHONPATH="$here/app"
fi
export PYTHONPATH PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1
# Git Bash turns an argument like /orders into C:/Program Files/Git/orders; tell the CLI what prefix to undo.
if command -v cygpath >/dev/null 2>&1; then AUTOSKILL_MSYS_ROOT=$(cygpath -m /); export AUTOSKILL_MSYS_ROOT; fi
exec "$py" -m autoskill "$@"
