{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA canonical testcase v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "revision",
    "lifecycle",
    "requirement_ids",
    "module",
    "title",
    "priority",
    "preconditions",
    "steps",
    "test_data",
    "expected",
    "source",
    "risk",
    "tags",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "kind": {
      "enum": [
        "ui",
        "api"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "preconditions": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_data": {
      "type": [
        "string",
        "object"
      ]
    },
    "risk": {
      "enum": [
        "read",
        "write",
        "delete",
        "payment",
        "refund",
        "message"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "automation": {
          "$ref": "#/$defs/automation"
        }
      }
    },
    "api_source": {
      "enum": [
        "openapi",
        "browser",
        "inferred",
        "source-and-official-docs",
        "manual"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/[^\\\\]*$"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "params": {
      "type": "object"
    },
    "json": {},
    "form": {
      "type": "object"
    },
    "assertions": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "json_equals": {
          "type": "object"
        },
        "schema": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "header_contains": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body_contains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "api"
          }
        }
      },
      "then": {
        "required": [
          "api_source",
          "source_ref",
          "method",
          "path",
          "assertions"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "api_source"
              ]
            },
            {
              "required": [
                "source_ref"
              ]
            },
            {
              "required": [
                "method"
              ]
            },
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "headers"
              ]
            },
            {
              "required": [
                "params"
              ]
            },
            {
              "required": [
                "json"
              ]
            },
            {
              "required": [
                "assertions"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "enum": [
            "testid",
            "role",
            "label",
            "placeholder",
            "text",
            "css"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "nth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "by": {
                "const": "role"
              }
            }
          },
          "then": {
            "required": [
              "role"
            ]
          },
          "else": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "tab_id": {
      "type": "string",
      "pattern": "^t[1-9][0-9]*$"
    },
    "tab_change": {
      "type": "object",
      "required": [
        "active"
      ],
      "properties": {
        "active": {
          "$ref": "#/$defs/tab_id"
        },
        "closed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tab_id"
          }
        },
        "opened": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/tab_id"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "relative_file": {
      "type": "string",
      "minLength": 1,
      "description": "Portable project/output relative POSIX file name; no absolute path, traversal, backslash, or runtime variable.",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*\\$\\{ENV:)(?!.*\\{\\{RAND\\}\\})(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "action": {
      "type": "object",
      "properties": {
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "target_locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabs": {
          "$ref": "#/$defs/tab_change"
        },
        "url": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "tab": {
          "$ref": "#/$defs/tab_id"
        },
        "active": {
          "$ref": "#/$defs/tab_id"
        },
        "image": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_file"
          }
        },
        "filename": {
          "$ref": "#/$defs/relative_file"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ]
        },
        "pixels": {
          "type": "number",
          "minimum": 0
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        },
        "state": {
          "enum": [
            "visible",
            "hidden",
            "attached",
            "detached"
          ]
        },
        "mode": {
          "enum": [
            "accept",
            "dismiss"
          ]
        },
        "button": {
          "enum": [
            "left",
            "middle",
            "right"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "delta_x": {
          "type": "number"
        },
        "delta_y": {
          "type": "number"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Per-step wait budget; may exceed the project timeout for long model responses."
        },
        "stable_for_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Assertion or selector wait must remain satisfied continuously for this duration."
        }
      },
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "goto"
            }
          },
