{
  "name": "dsh-plugin-autoskill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "autoSkill: dual AI/script QA engine, case Skills, dashboard and schedules for DeepSeek Harness",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "lib",
    "ui",
    "runtime",
    "skills",
    "examples",
    "requirements.txt",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "reports",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "dashboard": "node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sdk-client": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-sdk-client": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "agent-browser": "0.42.0"
  }
}
